<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/logoCircle"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/logo_circle_black"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher_logo" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/glassCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_dashboard"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoCircle">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/settingsInner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/settingsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/dailyCheckin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Daily check-in reminder"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    app:layout_constraintTop_toBottomOf="@id/settingsHeader"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/swDailyCheckin"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swDailyCheckin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintTop_toTopOf="@id/dailyCheckin"
                    app:layout_constraintBottom_toBottomOf="@id/dailyCheckin"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:id="@+id/divA"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/settings_divider"
                    app:layout_constraintTop_toBottomOf="@id/dailyCheckin"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- High Risk Alerts -->
                <TextView
                    android:id="@+id/highRiskAlerts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="High-risk alerts"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    app:layout_constraintTop_toBottomOf="@id/divA"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/swHighRiskAlerts"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swHighRiskAlerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintTop_toTopOf="@id/highRiskAlerts"
                    app:layout_constraintBottom_toBottomOf="@id/highRiskAlerts"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:id="@+id/divB"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/settings_divider"
                    app:layout_constraintTop_toBottomOf="@id/highRiskAlerts"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Daily recovery reminder -->
                <TextView
                    android:id="@+id/dailyRecovery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Daily Recovery reminders"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    app:layout_constraintTop_toBottomOf="@id/divB"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/swDailyRecovery"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swDailyRecovery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintTop_toTopOf="@id/dailyRecovery"
                    app:layout_constraintBottom_toBottomOf="@id/dailyRecovery"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/reminderTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reminder Time:"
                    android:textColor="#EDEDED"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_italic"
                    app:layout_constraintTop_toBottomOf="@id/dailyRecovery"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/etReminderTime"
                    android:layout_width="82dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/time_box_dark"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:inputType="time"
                    android:singleLine="true"
                    app:layout_constraintTop_toTopOf="@id/reminderTime"
                    app:layout_constraintBottom_toBottomOf="@id/reminderTime"
                    app:layout_constraintStart_toEndOf="@id/reminderTime"/>

                <Spinner
                    android:id="@+id/spinnerAmPm"
                    android:layout_width="68dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/time_box_dark"
                    android:popupBackground="@drawable/time_box_dark"
                    app:layout_constraintTop_toTopOf="@id/etReminderTime"
                    app:layout_constraintBottom_toBottomOf="@id/etReminderTime"
                    app:layout_constraintStart_toEndOf="@id/etReminderTime"
                    android:entries="@array/am_pm_options" />

                <View
                    android:id="@+id/divC"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/settings_divider"
                    app:layout_constraintTop_toBottomOf="@id/reminderTime"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Goal settings -->
                <TextView
                    android:id="@+id/goalSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Goal settings"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    app:layout_constraintTop_toBottomOf="@id/divC"
                    app:layout_constraintStart_toStartOf="parent"/>

                <Spinner
                    android:id="@+id/spinnerGoals"
                    android:layout_width="150dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/settings_dropdown_light"
                    android:entries="@array/goal_options"
                    app:layout_constraintTop_toTopOf="@id/goalSettings"
                    app:layout_constraintBottom_toBottomOf="@id/goalSettings"
                    app:layout_constraintStart_toEndOf="@id/goalSettings"/>

                <View
                    android:id="@+id/divD"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/settings_divider"
                    app:layout_constraintTop_toBottomOf="@id/goalSettings"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Injury focus -->
                <TextView
                    android:id="@+id/injuryFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Injury focus areas"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    app:layout_constraintTop_toBottomOf="@id/divD"
                    app:layout_constraintStart_toStartOf="parent"/>

                <Spinner
                    android:id="@+id/spinnerInjuryFocus"
                    android:layout_width="150dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/settings_dropdown_light"
                    android:entries="@array/injury_focus_options"
                    app:layout_constraintTop_toTopOf="@id/injuryFocus"
                    app:layout_constraintBottom_toBottomOf="@id/injuryFocus"
                    app:layout_constraintStart_toEndOf="@id/injuryFocus"/>

                <View
                    android:id="@+id/divE"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/settings_divider"
                    app:layout_constraintTop_toBottomOf="@id/injuryFocus"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Name -->
                <TextView
                    android:id="@+id/labelName"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Name"
                    android:textColor="#F3F3F3"
                    android:textSize="14sp"
                    android:translationY="-7dp"
                    android:fontFamily="@font/inter_regular"
                    app:layout_constraintTop_toBottomOf="@id/divE"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="86dp"
                    android:background="@drawable/time_box_dark"
                    android:text="Marco Santiago"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:translationY="-5dp"
                    app:layout_constraintTop_toTopOf="@id/labelName"
                    app:layout_constraintBottom_toBottomOf="@id/labelName"
                    app:layout_constraintStart_toEndOf="@id/labelName"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Age -->
                <TextView
                    android:id="@+id/labelAge"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Age"
                    android:textColor="#F3F3F3"
                    android:textSize="14sp"
                    android:translationY="-5dp"
                    android:fontFamily="@font/inter_regular"
                    app:layout_constraintTop_toBottomOf="@id/labelName"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/etAge"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="86dp"
                    android:background="@drawable/time_box_dark"
                    android:text="27"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:inputType="number"
                    android:singleLine="true"
                    android:translationY="-2dp"
                    app:layout_constraintTop_toTopOf="@id/labelAge"
                    app:layout_constraintBottom_toBottomOf="@id/labelAge"
                    app:layout_constraintStart_toEndOf="@id/labelAge"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Height -->
                <TextView
                    android:id="@+id/labelHeight"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Height"
                    android:textColor="#F3F3F3"
                    android:textSize="14sp"
                    android:translationY="-1dp"
                    android:fontFamily="@font/inter_regular"
                    app:layout_constraintTop_toBottomOf="@id/labelAge"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/etHeight"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="86dp"
                    android:background="@drawable/time_box_dark"
                    android:text="6'2"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:translationY="1dp"
                    app:layout_constraintTop_toTopOf="@id/labelHeight"
                    app:layout_constraintBottom_toBottomOf="@id/labelHeight"
                    app:layout_constraintStart_toEndOf="@id/labelHeight"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Weight -->
                <TextView
                    android:id="@+id/labelWeight"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Weight"
                    android:textColor="#F3F3F3"
                    android:textSize="14sp"
                    android:translationY="5dp"
                    android:fontFamily="@font/inter_regular"
                    app:layout_constraintTop_toBottomOf="@id/labelHeight"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/etWeight"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="86dp"
                    android:background="@drawable/time_box_dark"
                    android:text="202 lbs"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:translationY="5dp"
                    app:layout_constraintTop_toTopOf="@id/labelWeight"
                    app:layout_constraintBottom_toBottomOf="@id/labelWeight"
                    app:layout_constraintStart_toEndOf="@id/labelWeight"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Save button -->
                <FrameLayout
                    android:id="@+id/saveProfileButtonWrap"
                    android:layout_width="74dp"
                    android:layout_height="52dp"
                    app:layout_constraintTop_toTopOf="@id/etAge"
                    app:layout_constraintBottom_toBottomOf="@id/etWeight"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/SaveProfileButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/save_button"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"/>

                </FrameLayout>

                <View
                    android:id="@+id/divF"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/settings_divider"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/labelWeight" />

                <!--account settings button -->
                <FrameLayout
                    android:id="@+id/accountSettingsButtonWrap"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:translationY="10dp"
                    app:layout_constraintTop_toBottomOf="@id/divF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/AccountSettingsButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/account_settings_button"
                        android:scaleType="fitXY"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:id="@+id/accountSettingsContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/GearIcon"
                            android:layout_width="43dp"
                            android:layout_height="33dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/gear_icon"
                            android:translationY="-3dp"
                            android:translationX="-4dp"
                            android:scaleType="fitXY"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvAccountSettings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Account&#10;Settings"
                            android:textColor="#111111"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_extrabold"
                            android:gravity="center"
                            android:translationY="-3dp"
                            android:translationX="-13dp"
                            android:lineSpacingExtra="-1dp" />
                    </LinearLayout>

                </FrameLayout>

                <!-- logout button -->
                <FrameLayout
                    android:id="@+id/logoutButtonWrap"
                    android:layout_width="100dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="-30dp"
                    android:layout_marginEnd="120dp"
                    app:layout_constraintTop_toBottomOf="@id/accountSettingsButtonWrap"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/deleteAccountButtonWrap"
                    app:layout_constraintHorizontal_chainStyle="packed">

                    <ImageView
                        android:id="@+id/LogoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/logout_button"
                        android:scaleType="fitXY"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvLogout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Log Out"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:translationY="-4dp"
                        android:fontFamily="@font/inter_extrabold"
                        android:gravity="center" />

                </FrameLayout>

                <!-- delete account button -->
                <FrameLayout
                    android:id="@+id/deleteAccountButtonWrap"
                    android:layout_width="100dp"
                    android:layout_height="41dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="10dp"
                    android:translationY="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/logoutButtonWrap"
                    app:layout_constraintTop_toBottomOf="@+id/divF">

                    <ImageView
                        android:id="@+id/DeleteAccountButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/delete_account_button" />

                    <TextView
                        android:id="@+id/tvDeleteAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="Delete Account"
                        android:textColor="#2A1A12"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:translationY="-4dp" />

                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="6dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_calendar"
                android:onClick="onHistoryClick"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_clipboard_active"
                android:onClick="onLogClick"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_home"
                android:onClick="onDashboardClick"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_arm"
                android:onClick="onRecoveryClick"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_active_red"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_hex"
                android:scaleType="fitCenter" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>