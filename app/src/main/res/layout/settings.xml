<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- background -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- top logo -->
    <FrameLayout
        android:id="@+id/logoCircle"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/logo_circle_black"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_launcher_logo"
            android:scaleType="fitCenter"/>
    </FrameLayout>

    <!-- glass card -->
    <FrameLayout
        android:id="@+id/glassCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass"
        app:layout_constraintTop_toBottomOf="@id/logoCircle"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- background panel w/ a scroll wrapper -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:overScrollMode="never"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/settingsInner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- settings title-->
                    <TextView
                        android:id="@+id/settingsHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Settings"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_extrabold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- edit profile -->
                    <TextView
                        android:id="@+id/editProfile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Edit Profile"
                        android:textColor="#EDEDED"
                        android:textSize="16sp"
                        android:fontFamily="@font/inter_extrabold"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/settingsHeader"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <View
                        android:id="@+id/divA"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/settings_divider"
                        app:layout_constraintTop_toBottomOf="@id/editProfile"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- daily check-in reminder -->
                    <TextView
                        android:id="@+id/dailyCheckin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Daily check-in reminder"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/divA"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/swDailyCheckin"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swDailyCheckin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:layout_constraintTop_toTopOf="@id/dailyCheckin"
                        app:layout_constraintBottom_toBottomOf="@id/dailyCheckin"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <View
                        android:id="@+id/divB"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/settings_divider"
                        app:layout_constraintTop_toBottomOf="@id/dailyCheckin"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- high-risk alerts -->
                    <TextView
                        android:id="@+id/highRiskAlerts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="High-risk alerts"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/divB"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/swHighRiskAlerts"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swHighRiskAlerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:layout_constraintTop_toTopOf="@id/highRiskAlerts"
                        app:layout_constraintBottom_toBottomOf="@id/highRiskAlerts"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <View
                        android:id="@+id/divC"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/settings_divider"
                        app:layout_constraintTop_toBottomOf="@id/highRiskAlerts"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- daily recovery reminders -->
                    <TextView
                        android:id="@+id/dailyRecovery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Daily Recovery reminders"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/divC"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/swDailyRecovery"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swDailyRecovery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:layout_constraintTop_toTopOf="@id/dailyRecovery"
                        app:layout_constraintBottom_toBottomOf="@id/dailyRecovery"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- reminder time row -->
                    <TextView
                        android:id="@+id/reminderTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reminder Time:"
                        android:textColor="#EDEDED"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_italic"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/dailyRecovery"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <EditText
                        android:id="@+id/etReminderTime"
                        android:layout_width="78dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:background="@drawable/time_box_dark"
                        android:inputType="text"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        app:layout_constraintTop_toTopOf="@id/reminderTime"
                        app:layout_constraintBottom_toBottomOf="@id/reminderTime"
                        app:layout_constraintStart_toEndOf="@id/reminderTime"/>

                    <!-- save pill -->
                    <Button
                        android:id="@+id/btnSaveReminder"
                        android:layout_width="58dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:text=""
                        android:background="@drawable/settings_save_small"
                        android:stateListAnimator="@null"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        app:backgroundTint="@null"
                        app:layout_constraintTop_toTopOf="@id/etReminderTime"
                        app:layout_constraintBottom_toBottomOf="@id/etReminderTime"
                        app:layout_constraintStart_toEndOf="@id/etReminderTime"/>

                    <TextView
                        android:id="@+id/saveReminderLabel"
                        android:layout_width="58dp"
                        android:layout_height="28dp"
                        android:text="Save"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0A0A0A"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:clickable="false"
                        android:focusable="false"
                        app:layout_constraintTop_toTopOf="@id/btnSaveReminder"
                        app:layout_constraintBottom_toBottomOf="@id/btnSaveReminder"
                        app:layout_constraintStart_toStartOf="@id/btnSaveReminder"
                        app:layout_constraintEnd_toEndOf="@id/btnSaveReminder"/>

                    <View
                        android:id="@+id/divD"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/settings_divider"
                        app:layout_constraintTop_toBottomOf="@id/reminderTime"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- goal settings -->
                    <TextView
                        android:id="@+id/goalSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goal settings"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@id/divD"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <Spinner
                        android:id="@+id/spinnerGoals"
                        android:layout_width="100dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/settings_dropdown_light"
                        android:popupBackground="@drawable/dropdown_popup_light"
                        android:entries="@array/goal_options"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:spinnerMode="dropdown"
                        android:fontFamily="@font/inter_bold"
                        app:layout_constraintTop_toTopOf="@id/goalSettings"
                        app:layout_constraintBottom_toBottomOf="@id/goalSettings"
                        app:layout_constraintStart_toEndOf="@id/goalSettings"/>

                    <!-- save pill -->
                    <Button
                        android:id="@+id/btnSaveGoals"
                        android:layout_width="70dp"
                        android:layout_height="28dp"
                        android:text=""
                        android:background="@drawable/settings_save_small"
                        android:stateListAnimator="@null"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        app:backgroundTint="@null"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="160dp"
                        android:translationY="-32dp"
                        app:layout_constraintTop_toBottomOf="@id/goalSettings"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/saveGoalsLabel"
                        android:layout_width="70dp"
                        android:layout_height="28dp"
                        android:text="Save"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0A0A0A"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:clickable="false"
                        android:focusable="false"
                        android:translationY="-32dp"
                        app:layout_constraintTop_toTopOf="@id/btnSaveGoals"
                        app:layout_constraintBottom_toBottomOf="@id/btnSaveGoals"
                        app:layout_constraintStart_toStartOf="@id/btnSaveGoals"
                        app:layout_constraintEnd_toEndOf="@id/btnSaveGoals"/>

                    <View
                        android:id="@+id/divE"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="-20dp"
                        android:background="@drawable/settings_divider"
                        app:layout_constraintTop_toBottomOf="@id/btnSaveGoals"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- injury focus areas -->
                    <TextView
                        android:id="@+id/injuryFocus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Injury focus areas"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@id/divE"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <Spinner
                        android:id="@+id/spinnerInjuryFocus"
                        android:layout_width="100dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/settings_dropdown_light"
                        android:popupBackground="@drawable/dropdown_popup_light"
                        android:entries="@array/injury_focus_options"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:spinnerMode="dropdown"
                        android:fontFamily="@font/inter_bold"
                        app:layout_constraintTop_toTopOf="@id/injuryFocus"
                        app:layout_constraintBottom_toBottomOf="@id/injuryFocus"
                        app:layout_constraintStart_toEndOf="@id/injuryFocus"/>

                    <!-- save pill  -->
                    <Button
                        android:id="@+id/btnSaveInjury"
                        android:layout_width="70dp"
                        android:layout_height="28dp"
                        android:text=""
                        android:background="@drawable/settings_save_small"
                        android:stateListAnimator="@null"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        app:backgroundTint="@null"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="220dp"
                        android:translationY="-32dp"
                        app:layout_constraintTop_toBottomOf="@id/injuryFocus"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>


                    <TextView
                        android:id="@+id/saveInjuryLabel"
                        android:layout_width="70dp"
                        android:layout_height="28dp"
                        android:text="Save"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0A0A0A"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:clickable="false"
                        android:focusable="false"
                        android:translationY="-32dp"
                        app:layout_constraintTop_toTopOf="@id/btnSaveInjury"
                        app:layout_constraintBottom_toBottomOf="@id/btnSaveInjury"
                        app:layout_constraintStart_toStartOf="@id/btnSaveInjury"
                        app:layout_constraintEnd_toEndOf="@id/btnSaveInjury"/>

                    <View
                        android:id="@+id/divF"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="-20dp"
                        android:background="@drawable/settings_divider"
                        app:layout_constraintTop_toBottomOf="@id/btnSaveInjury"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- workout log history -->
                    <TextView
                        android:id="@+id/logHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Workout Log History"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/divF"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <!-- check logs pill -->
                    <Button
                        android:id="@+id/btnCheckLogs"
                        android:layout_width="120dp"
                        android:layout_height="34dp"
                        android:text=""
                        android:background="@drawable/check_logs_pill"
                        android:stateListAnimator="@null"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        app:backgroundTint="@null"
                        app:layout_constraintTop_toTopOf="@id/logHistory"
                        app:layout_constraintBottom_toBottomOf="@id/logHistory"
                        app:layout_constraintEnd_toEndOf="parent"/>


                    <TextView
                        android:id="@+id/checkLogsLabel"
                        android:layout_width="120dp"
                        android:layout_height="34dp"
                        android:text="Check Logs"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0A0A0A"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:clickable="false"
                        android:focusable="false"
                        app:layout_constraintTop_toTopOf="@id/btnCheckLogs"
                        app:layout_constraintBottom_toBottomOf="@id/btnCheckLogs"
                        app:layout_constraintStart_toStartOf="@id/btnCheckLogs"
                        app:layout_constraintEnd_toEndOf="@id/btnCheckLogs"/>

                    <View
                        android:id="@+id/divG"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/settings_divider"
                        app:layout_constraintTop_toBottomOf="@id/logHistory"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- log out pill -->
                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="100dp"
                        android:layout_height="70dp"
                        android:text=""
                        android:background="@drawable/logout_pill"
                        android:stateListAnimator="@null"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        app:backgroundTint="@null"
                        android:layout_marginTop="18dp"
                        android:layout_marginEnd="150dp"
                        app:layout_constraintTop_toBottomOf="@id/divG"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/logoutLabel"
                        android:layout_width="100dp"
                        android:layout_height="70dp"
                        android:text="Log Out"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#0A0A0A"
                        android:fontFamily="@font/inter_extrabold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:clickable="false"
                        android:focusable="false"
                        app:layout_constraintTop_toTopOf="@id/btnLogout"
                        app:layout_constraintBottom_toBottomOf="@id/btnLogout"
                        app:layout_constraintStart_toStartOf="@id/btnLogout"
                        app:layout_constraintEnd_toEndOf="@id/btnLogout"/>

                    <!-- delete account pill -->
                    <Button
                        android:id="@+id/btnDeleteAccount"
                        android:layout_width="100dp"
                        android:layout_height="70dp"
                        android:text=""
                        android:background="@drawable/delete_account_pill"
                        android:stateListAnimator="@null"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        app:backgroundTint="@null"
                        android:layout_marginBottom="10dp"
                        android:translationY="-70dp"
                        android:layout_marginStart="150dp"
                        app:layout_constraintTop_toBottomOf="@id/btnLogout"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>


                    <TextView
                        android:id="@+id/deleteAccountLabel"
                        android:layout_width="100dp"
                        android:layout_height="70dp"
                        android:text="Delete Account"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#0A0A0A"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:clickable="false"
                        android:focusable="false"
                        android:translationY="-70dp"
                        app:layout_constraintTop_toTopOf="@id/btnDeleteAccount"
                        app:layout_constraintBottom_toBottomOf="@id/btnDeleteAccount"
                        app:layout_constraintStart_toStartOf="@id/btnDeleteAccount"
                        app:layout_constraintEnd_toEndOf="@id/btnDeleteAccount"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- bottom nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="6dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="onProfileClick"
                android:src="@drawable/nav_avatar"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="onLogClick"
                android:src="@drawable/nav_clipboard_active"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="onDashboardClick"
                android:src="@drawable/nav_home"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="onRecoveryClick"
                android:src="@drawable/nav_arm"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_active_red"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_hex"
                android:scaleType="fitCenter" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>