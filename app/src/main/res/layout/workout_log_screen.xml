<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <FrameLayout
        android:id="@+id/logoCircle"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/logo_circle_black"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintTop_margin="36dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_launcher_logo"
            android:scaleType="fitCenter"/>
    </FrameLayout>


    <FrameLayout
        android:id="@+id/glassCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass"
        app:layout_constraintTop_toBottomOf="@id/logoCircle"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/panel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/panel_black"
                android:padding="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- title -->
                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="LOG WORKOUT"
                    android:textColor="#66E6FF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- exercise name -->
                <TextView
                    android:id="@+id/exerciseNameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="EXERCISE NAME"
                    android:textColor="#66E6FF"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    android:fontFamily="@font/inter_bold"
                    app:layout_constraintTop_toBottomOf="@id/title"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- exercise name input -->
                <EditText
                    android:id="@+id/etExerciseName"
                    android:layout_width="130dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/input_white_box"
                    android:hint=""
                    android:textColor="#0A0A0A"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:includeFontPadding="false"
                    app:layout_constraintTop_toTopOf="@id/exerciseNameLabel"
                    app:layout_constraintBottom_toBottomOf="@id/exerciseNameLabel"
                    app:layout_constraintStart_toEndOf="@id/exerciseNameLabel" />

                <!-- description-->
                <TextView
                    android:id="@+id/descriptionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="DESCRIPTION"
                    android:textColor="#66E6FF"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    android:fontFamily="@font/inter_bold"
                    app:layout_constraintTop_toBottomOf="@id/exerciseNameLabel"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- description box input -->
                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/input_lime_box"
                    android:hint=""
                    android:textColor="#0A0A0A"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="top|start"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:inputType="textMultiLine"
                    android:includeFontPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/descriptionLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- duration-->
                <TextView
                    android:id="@+id/durationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="DURATION"
                    android:textColor="#66E6FF"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    android:fontFamily="@font/inter_bold"
                    app:layout_constraintTop_toBottomOf="@id/etDescription"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:id="@+id/durationRow"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/durationLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- box 1 - editable  -->
                    <FrameLayout
                        android:id="@+id/durationValueWrap"
                        android:layout_width="92dp"
                        android:layout_height="match_parent">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/metric_cyan_box" />

                        <EditText
                            android:id="@+id/etDurationValue"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:text="30"
                            android:textColor="#0A0A0A"
                            android:textStyle="bold"
                            android:textSize="26sp"
                            android:fontFamily="@font/inter_extrabold"
                            android:gravity="center"
                            android:singleLine="true"
                            android:inputType="number"
                            android:includeFontPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />
                    </FrameLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <!-- box 2: fixed mins label-->
                    <FrameLayout
                        android:id="@+id/durationUnitWrap"
                        android:layout_width="92dp"
                        android:layout_height="match_parent">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/metric_cyan_box" />

                        <TextView
                            android:id="@+id/durationUnit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="mins"
                            android:textColor="#0A0A0A"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:fontFamily="@font/inter_extrabold"
                            android:gravity="center"
                            android:includeFontPadding="false" />
                    </FrameLayout>

                    <Space
                        android:layout_width="14dp"
                        android:layout_height="1dp" />

                    <!-- save -->
                    <FrameLayout
                        android:id="@+id/saveDurationWrap"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/btnSaveDuration"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text=""
                            android:background="@drawable/save_pill_workout"
                            android:stateListAnimator="@null"
                            android:includeFontPadding="false"
                            app:backgroundTint="@null" />

                        <TextView
                            android:id="@+id/saveDurationLabel"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="SAVE"
                            android:textColor="#0A0A0A"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_extrabold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:clickable="false"
                            android:focusable="false" />
                    </FrameLayout>

                </LinearLayout>

                <!-- intensity-->
                <TextView
                    android:id="@+id/intensityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="INTENSITY"
                    android:textColor="#66E6FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_bold"
                    android:letterSpacing="0.06"
                    app:layout_constraintTop_toBottomOf="@id/durationRow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- intensity bar - 6 separate image blocks-  -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/intensityCard"
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/intensityLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:id="@+id/intensityRow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="6">

                        <ImageView
                            android:id="@+id/intensityVeryLight"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/intensity_very_light"
                            android:scaleType="fitXY"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/intensityLight"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/intensity_light"
                            android:scaleType="fitXY"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/intensityMild"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/intensity_mild"
                            android:scaleType="fitXY"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/intensityHard"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/intensity_hard"
                            android:scaleType="fitXY"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/intensityVeryHard"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/intensity_very_hard"
                            android:scaleType="fitXY"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/intensityMax"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/intensity_max"
                            android:scaleType="fitXY"
                            android:contentDescription="@null" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- intensity save -->
                <Button
                    android:id="@+id/btnSaveIntensity"
                    android:layout_width="90dp"
                    android:layout_height="54dp"
                    android:text=""
                    android:background="@drawable/save_pill_workout"
                    android:stateListAnimator="@null"
                    android:includeFontPadding="false"
                    app:backgroundTint="@null"
                    android:layout_marginTop="22dp"
                    app:layout_constraintTop_toBottomOf="@id/intensityCard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/saveIntensityLabel"
                    android:layout_width="90dp"
                    android:layout_height="46dp"
                    android:text="SAVE"
                    android:textColor="#0A0A0A"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_extrabold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:clickable="false"
                    android:focusable="false"
                    app:layout_constraintTop_toTopOf="@id/btnSaveIntensity"
                    app:layout_constraintBottom_toBottomOf="@id/btnSaveIntensity"
                    app:layout_constraintStart_toStartOf="@id/btnSaveIntensity"
                    app:layout_constraintEnd_toEndOf="@id/btnSaveIntensity" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- bottom nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="6dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_avatar"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_active_red"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_clipboard_active"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_home"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_arm"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <Space android:layout_width="14dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nav_hex"
                android:scaleType="fitCenter" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>