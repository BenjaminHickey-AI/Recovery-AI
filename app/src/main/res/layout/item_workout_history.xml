<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardWorkoutItem"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="#CFCFE0"
    tools:background="#FF00FF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <!-- day bubble -->
        <FrameLayout
            android:id="@+id/dayBubble"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/day_bubble_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/day"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Tue"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="25sp"
                android:fontFamily="@font/inter_extrabold"
                android:gravity="center"
                android:includeFontPadding="false" />
        </FrameLayout>

        <!-- date -->
        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOVEMBER 5"
            android:textColor="#0A0A0A"
            android:textSize="10sp"
            android:fontFamily="@font/inter_regular"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/dayBubble"
            app:layout_constraintStart_toEndOf="@id/dayBubble" />

        <!-- duration -->
        <TextView
            android:id="@+id/durationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duration:"
            android:textColor="#0A0A0A"
            android:textSize="12sp"
            android:fontFamily="@font/figtree_extrabold"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/date"
            app:layout_constraintStart_toStartOf="@id/date" />

        <TextView
            android:id="@+id/durationValue"
            android:layout_width="92dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:text="90 MINS"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="11sp"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:background="@drawable/duration_pill_bg"
            app:layout_constraintTop_toTopOf="@id/durationLabel"
            app:layout_constraintBottom_toBottomOf="@id/durationLabel"
            app:layout_constraintStart_toEndOf="@id/durationLabel" />

        <!-- intensity -->
        <TextView
            android:id="@+id/intensity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intensity:"
            android:textColor="#0A0A0A"
            android:textSize="12sp"
            android:fontFamily="@font/figtree_extrabold"
            android:layout_marginEnd="6dp"
            app:layout_constraintTop_toTopOf="@id/date"
            app:layout_constraintEnd_toStartOf="@id/fireIconWrap" />

        <!-- fire icon set !!! (6 separate ImageViews)-->
        <FrameLayout
            android:id="@+id/fireIconWrap"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:layout_constraintTop_toTopOf="@id/intensity"
            app:layout_constraintBottom_toBottomOf="@id/intensity"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- very light -->
            <ImageView
                android:id="@+id/fireVeryLight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fire_very_light"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:visibility="visible"
                tools:visibility="visible" />

            <!-- light -->
            <ImageView
                android:id="@+id/fireLight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fire_light"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:visibility="gone"
                tools:visibility="gone" />

            <!-- mild -->
            <ImageView
                android:id="@+id/fireMild"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fire_mild"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:visibility="gone"
                tools:visibility="gone" />

            <!-- hard -->
            <ImageView
                android:id="@+id/fireHard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fire_hard"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:visibility="gone"
                tools:visibility="gone" />

            <!-- very hard -->
            <ImageView
                android:id="@+id/fireVeryHard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fire_very_hard"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:visibility="gone"
                tools:visibility="gone" />

            <!-- max -->
            <ImageView
                android:id="@+id/fireMax"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fire_max"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:visibility="gone"
                tools:visibility="gone" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>