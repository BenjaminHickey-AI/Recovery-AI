<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top logo circle -->
    <FrameLayout
        android:id="@+id/logoCircle"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/logo_circle_black"
        android:padding="8dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintTop_margin="36dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher_logo" />
    </FrameLayout>


    <FrameLayout
        android:id="@+id/glassCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass"
        app:layout_constraintTop_toBottomOf="@id/logoCircle"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <!-- ===== Top widgets row ===== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topWidgetsRow"
                android:layout_width="0dp"
                android:layout_height="160dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Recovery Recommendations card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecoveryRec"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="10dp"
                    app:cardUseCompatPadding="false"
                    app:cardPreventCornerOverlap="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cardHighRisk"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:backgrounTint="@null"
                    app:layout_constraintWidth_percent="0.52">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_card"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:backgrounTint="@null"
                        android:padding="8dp">

                        <!-- Title -->
                        <TextView
                            android:id="@+id/recTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Recovery Recommendations"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Thumbnail -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/recThumbCard"
                            android:layout_width="0dp"
                            android:layout_height="78dp"
                            android:layout_marginTop="6dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardUseCompatPadding="false"
                            app:cardPreventCornerOverlap="true"
                            app:layout_constraintTop_toBottomOf="@id/recTitle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:id="@+id/imgRecThumb"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/recovery_thumb_placeholder" />
                        </androidx.cardview.widget.CardView>

                        <!-- Bottom white info strip -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/recInfoBar"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardUseCompatPadding="false"
                            app:cardPreventCornerOverlap="true"
                            app:cardBackgroundColor="#FFFFFF"
                            app:layout_constraintTop_toBottomOf="@id/recThumbCard"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp">

                                <TextView
                                    android:id="@+id/recCategory"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="Stretch &amp; Recovery"
                                    android:textColor="#0E0E0E"
                                    android:textSize="9sp"
                                    android:fontFamily="@font/inter_regular"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toStartOf="@id/btnSeeMore" />

                                <TextView
                                    android:id="@+id/recMeta"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="10-Minute Standing Mobility"
                                    android:textColor="#0E0E0E"
                                    android:textSize="6sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/inter_bold"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    app:layout_constraintTop_toBottomOf="@id/recCategory"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toStartOf="@id/btnSeeMore"
                                    app:layout_constraintBottom_toBottomOf="parent" />

                                <!-- Button background -->
                                <Button
                                    android:id="@+id/btnSeeMore"
                                    android:layout_width="66dp"
                                    android:layout_height="28dp"
                                    android:text=""
                                    android:textAllCaps="false"
                                    android:background="@drawable/mini_dark_button"
                                    android:stateListAnimator="@null"
                                    android:includeFontPadding="false"
                                    android:gravity="center"
                                    app:backgroundTint="@null"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent" />

                                <!-- Text -->
                                <TextView
                                    android:id="@+id/seeMoreLabel"
                                    android:layout_width="66dp"
                                    android:layout_height="28dp"
                                    android:text="See\nMore"
                                    android:textColor="#FFFFFF"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/inter_bold"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:clickable="false"
                                    android:focusable="false"
                                    android:translationY="-1dp"
                                    app:layout_constraintTop_toTopOf="@id/btnSeeMore"
                                    app:layout_constraintBottom_toBottomOf="@id/btnSeeMore"
                                    app:layout_constraintStart_toStartOf="@id/btnSeeMore"
                                    app:layout_constraintEnd_toEndOf="@id/btnSeeMore" />

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.cardview.widget.CardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- High Risk card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardHighRisk"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/widget_card"
                    android:padding="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cardRecoveryRec"
                    app:layout_constraintWidth_percent="0.44">

                    <TextView
                        android:id="@+id/highRisk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High Risk"
                        android:textColor="#EDEDED"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter_bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Ring area -->
                    <FrameLayout
                        android:id="@+id/riskRingWrap"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        app:layout_constraintTop_toBottomOf="@id/highRisk"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/btnWhy">

                        <!-- Ring placeholder image -->
                        <ImageView
                            android:id="@+id/imgRiskRing"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/risk_ring_placeholder"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true" />

                        <!-- Score-->
                        <TextView
                            android:id="@+id/riskScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="83"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_extrabold"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <!-- Why button -->
                    <Button
                        android:id="@+id/btnWhy"
                        android:layout_width="46dp"
                        android:layout_height="22dp"
                        android:text=""
                        android:background="@drawable/mini_dark_button"
                        android:stateListAnimator="@null"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        app:backgroundTint="@null"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Why label-->
                    <TextView
                        android:id="@+id/whyLabel"
                        android:layout_width="46dp"
                        android:layout_height="22dp"
                        android:text="Why?"
                        android:textAllCaps="false"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:clickable="false"
                        android:focusable="false"
                        android:translationY="-0.5dp"
                        app:layout_constraintTop_toTopOf="@id/btnWhy"
                        app:layout_constraintBottom_toBottomOf="@id/btnWhy"
                        app:layout_constraintStart_toStartOf="@id/btnWhy"
                        app:layout_constraintEnd_toEndOf="@id/btnWhy" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ===== Center body ===== -->
            <ImageView
                android:id="@+id/imgBody"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/body"
                app:layout_constraintTop_toBottomOf="@id/topWidgetsRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/recoveryGuideCard"
                app:layout_constraintVertical_bias="0.35" />

            <!-- ===== Glows ===== -->
            <ImageView
                android:id="@+id/glowGreen"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:src="@drawable/glow_green"
                android:alpha="0.95"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toTopOf="@id/imgBody"
                app:layout_constraintBottom_toBottomOf="@id/imgBody"
                app:layout_constraintStart_toStartOf="@id/imgBody"
                app:layout_constraintEnd_toEndOf="@id/imgBody" />

            <ImageView
                android:id="@+id/glowRed"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:src="@drawable/glow_red"
                android:layout_marginBottom="160dp"
                android:layout_marginStart="60dp"
                android:scaleType="fitCenter"
                android:alpha="0.85"
                app:layout_constraintTop_toTopOf="@id/imgBody"
                app:layout_constraintBottom_toBottomOf="@id/imgBody"
                app:layout_constraintStart_toStartOf="@id/imgBody"
                app:layout_constraintEnd_toEndOf="@id/imgBody" />

            <!-- ===== Connector lines ===== -->
            <ImageView
                android:id="@+id/lineGreen"
                android:layout_width="120dp"
                android:layout_height="60dp"
                android:src="@drawable/line_green"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toEndOf="@id/bubbleSoreness"
                app:layout_constraintTop_toTopOf="@id/bubbleSoreness"
                android:layout_marginStart="-15dp"
                android:layout_marginTop="-32dp" />

            <ImageView
                android:id="@+id/lineRed"
                android:layout_width="120dp"
                android:layout_height="60dp"
                android:src="@drawable/line_red"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toStartOf="@id/bubbleRisk"
                app:layout_constraintTop_toTopOf="@id/bubbleRisk"
                android:layout_marginEnd="-57dp"
                android:layout_marginTop="-50dp" />

            <TextView
                android:id="@+id/basedOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="* Based on\nyour last 7 days"
                android:textColor="#EDEDED"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintTop_toTopOf="@id/imgBody"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="18dp" />

            <!-- soreness bubble -->
            <LinearLayout
                android:id="@+id/bubbleSoreness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bubble_white"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:orientation="vertical"
                android:translationY="-40dp"
                android:translationX="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/imgBody"
                android:layout_marginBottom="110dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Soreness:\nLegs"
                    android:textColor="#0A0A0A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_bold" />
            </LinearLayout>

            <!-- bubble -->
            <LinearLayout
                android:id="@+id/bubbleRisk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bubble_white"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgBody"
                android:layout_marginTop="90dp"
                android:translationY="-70dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High strain\nrisk: Shoulder ⚠"
                    android:textColor="#D10000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_bold" />
            </LinearLayout>


            <!-- Right side actions -->
            <LinearLayout
                android:id="@+id/rightActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/imgBody">

                <!-- Trends  -->
                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="32dp">

                    <Button
                        android:id="@+id/btnTrends"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:background="@drawable/mini_dark_button"
                        android:stateListAnimator="@null"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        app:backgroundTint="@null" />

                    <LinearLayout
                        android:id="@+id/trendsOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="false"
                        android:focusable="false"
                        android:translationY="-0.5dp">

                        <TextView
                            android:id="@+id/trendsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trends"
                            android:textSize="11sp"
                            android:textColor="#8DFFB0"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false" />

                        <ImageView
                            android:id="@+id/imgTrendsIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/trends_icon_placeholder"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                    </LinearLayout>

                </FrameLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="12dp" />

                <!-- Check-in -->
                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="32dp">

                    <Button
                        android:id="@+id/btnCheckin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:textAllCaps="false"
                        android:background="@drawable/mini_dark_button"
                        android:stateListAnimator="@null"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        app:backgroundTint="@null" />

                    <LinearLayout
                        android:id="@+id/checkinOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="false"
                        android:focusable="false"
                        android:translationY="-0.5dp">

                        <TextView
                            android:id="@+id/checkinLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Check-in"
                            android:textSize="11sp"
                            android:textColor="#72D6FF"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false" />

                        <ImageView
                            android:id="@+id/imgCheckinIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/checkin_icon_placeholder"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>
            <!-- ===== Bottom Recovery Guide bar ===== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/recoveryGuideCard"
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/widget_card"
                android:padding="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/recoveryGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recovery Guide"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:gravity="center" />

                <LinearLayout
                    android:id="@+id/segmentsRow"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    app:layout_constraintTop_toBottomOf="@id/recoveryGuide"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <!-- Hydrate -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/seg_hydrate"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/imgHydrateIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/icon_hydrate"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/hydrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hydrate"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <!-- Stretch -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/seg_stretch"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/imgStretchIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/icon_stretch"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/stretch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stretch"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <!-- Rest -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/seg_rest"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/imgRestIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/icon_rest"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/rest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rest"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- Bottom nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Profile -->
        <FrameLayout
            android:layout_width="58dp"
