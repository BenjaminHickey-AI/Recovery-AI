<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/logoCircle"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/logo_circle_black"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher_logo" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/glassCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_dashboard"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoCircle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp">

            <ImageView
                android:id="@+id/imgRecoveryAiTitle"
                android:layout_width="220dp"
                android:layout_height="42dp"
                android:layout_marginTop="25dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/recovery_ai_title_placeholder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/particlesAnchor"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="70dp"
                android:background="@android:color/transparent"
                app:layout_constraintTop_toBottomOf="@id/imgRecoveryAiTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- high level -->
            <FrameLayout
                android:id="@+id/highRiskTitleWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgRecoveryAiTitle">

                <TextView
                    android:id="@+id/highRiskGlow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arial_black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    android:shadowColor="#FF5C5C"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="18"
                    android:text="HIGH RISK"
                    android:textAllCaps="true"
                    android:textColor="#FF3B30"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/highRiskFront"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arial_black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    android:text="HIGH RISK"
                    android:textAllCaps="true"
                    android:textColor="#FFD0A8"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- low level -->
            <FrameLayout
                android:id="@+id/lowRiskTitleWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgRecoveryAiTitle">

                <TextView
                    android:id="@+id/lowRiskGlow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arial_black"
                    android:gravity="center"
                    android:includeFontPadding="true"
                    android:letterSpacing="0.03"
                    android:shadowColor="#66FF33"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="18"
                    android:text="LOW RISK"
                    android:textAllCaps="true"
                    android:textColor="#39FF14"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lowRiskFront"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arial_black"
                    android:gravity="center"
                    android:includeFontPadding="true"
                    android:letterSpacing="0.03"
                    android:text="LOW RISK"
                    android:textAllCaps="true"
                    android:textColor="#DFFF9D"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- moderate level -->
            <FrameLayout
                android:id="@+id/moderateRiskTitleWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgRecoveryAiTitle">

                <TextView
                    android:id="@+id/moderateRiskGlow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arial_black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:shadowColor="#FFE45C"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="18"
                    android:text="MODERATE RISK"
                    android:textAllCaps="true"
                    android:textColor="#FFD400"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/moderateRiskFront"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arial_black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:text="MODERATE RISK"
                    android:textAllCaps="true"
                    android:textColor="#FFF1A8"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- particles -->
            <ImageView
                android:id="@+id/imgParticlesShared"
                android:layout_width="0dp"
                android:layout_height="280dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/particles"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/particlesAnchor" />

            <!-- guy -->
            <ImageView
                android:id="@+id/bodyHigh"
                android:layout_width="118dp"
                android:layout_height="210dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/guy_high"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/imgParticlesShared"
                app:layout_constraintEnd_toEndOf="@id/imgParticlesShared"
                app:layout_constraintStart_toStartOf="@id/imgParticlesShared"
                app:layout_constraintTop_toTopOf="@id/imgParticlesShared" />

            <ImageView
                android:id="@+id/bodyLow"
                android:layout_width="118dp"
                android:layout_height="210dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/guy_low"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@id/imgParticlesShared"
                app:layout_constraintEnd_toEndOf="@id/imgParticlesShared"
                app:layout_constraintStart_toStartOf="@id/imgParticlesShared"
                app:layout_constraintTop_toTopOf="@id/imgParticlesShared" />

            <ImageView
                android:id="@+id/bodyModerate"
                android:layout_width="118dp"
                android:layout_height="210dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/guy_moderate"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/imgParticlesShared"
                app:layout_constraintEnd_toEndOf="@id/imgParticlesShared"
                app:layout_constraintStart_toStartOf="@id/imgParticlesShared"
                app:layout_constraintTop_toTopOf="@id/imgParticlesShared" />

            <!-- symbols -->
            <ImageView
                android:id="@+id/symbolHigh"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginEnd="75dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/plus_high"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/imgParticlesShared"
                app:layout_constraintTop_toTopOf="@id/imgParticlesShared" />

            <ImageView
                android:id="@+id/symbolModerate"
                android:layout_width="60dp"
                android:layout_height="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="80dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/minus_moderate"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/imgParticlesShared"
                app:layout_constraintTop_toTopOf="@id/imgParticlesShared" />

            <!-- Gym Equipment -->
            <ImageView
                android:id="@+id/dumbbellHigh"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/dumbbell_high"
                android:translationY="-75dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/dumbbellLow"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/dumbbell_low"
                android:visibility="visible"
                android:translationY="-75dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/dumbbellModerate"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/dumbbell_moderate"
                android:visibility="gone"
                android:translationY="-75dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/treadmillHigh"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/treadmill_high"
                android:visibility="gone"
                android:translationY="-75dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/treadmillLow"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/treadmill_low"
                android:visibility="visible"
                android:translationY="-75dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/treadmillModerate"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/treadmill_moderate"
                android:visibility="gone"
                android:translationY="-75dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />



            <!-- Streaks section -->
            <LinearLayout
                android:id="@+id/streakSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tvDashboardSuggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_glass"
                    android:padding="14dp"
                    android:text="Recovery insights will appear here..."
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp"
                    android:fontFamily="@font/inter_regular"
                    app:layout_constraintBottom_toTopOf="@id/streakSection"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/streakLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="Your streak"
                    android:textColor="#F3F3F3"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/streakBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dayM"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/streak_day_glass"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="M"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dayT"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/streak_day_glass"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dayW"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/streak_day_glass"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="W"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dayTH"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/streak_day_glass"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="TH"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dayF"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/streak_day_glass"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="F"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dayS"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/streak_day_glass"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="S"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/daySUN"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/streak_day_active"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="Sun"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">

            <ImageView
                android:id="@+id/navCalendar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="onHistoryClick"
                android:scaleType="fitCenter"
                android:src="@drawable/nav_calendar" />
        </FrameLayout>

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">

            <ImageView
                android:id="@+id/navClipboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="onLogClick"
                android:scaleType="fitCenter"
                android:src="@drawable/nav_clipboard_active" />
        </FrameLayout>

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/nav_circle_active_red"
            android:padding="10dp">

            <ImageView
                android:id="@+id/navHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/nav_home" />
        </FrameLayout>

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">

            <ImageView
                android:id="@+id/navArm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="onRecoveryClick"
                android:scaleType="fitCenter"
                android:src="@drawable/nav_arm" />
        </FrameLayout>

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/nav_circle_bg"
            android:padding="10dp">

            <ImageView
                android:id="@+id/navHex"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="onSettingsClick"
                android:scaleType="fitCenter"
                android:src="@drawable/nav_hex" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>