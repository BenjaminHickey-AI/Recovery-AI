<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Glass card container -->
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="22dp"
        android:background="@drawable/bg_glass"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="22dp">

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Upload an Image"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Circle image placeholder -->
            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/profile_circle_bg"
                android:scaleType="centerCrop"
                android:contentDescription="@string/profile_image"
                app:layout_constraintTop_toBottomOf="@id/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Choose from Library -->
            <Button
                android:id="@+id/btnChoose"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:text="Choose from Library"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_extrabold"
                android:background="@drawable/black_pill"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"
                app:layout_constraintTop_toBottomOf="@id/imgProfile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Take a Photo -->
            <Button
                android:id="@+id/btnTakePhoto"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="Take a Photo"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_extrabold"
                android:background="@drawable/black_pill"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"
                app:layout_constraintTop_toBottomOf="@id/btnChoose"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


            <!-- Back / Next  -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/green_pill"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:elevation="10dp"
                android:stateListAnimator="@null"
                app:layout_constraintTop_toBottomOf="@id/btnTakePhoto"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnNext"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="14dp"/>

            <Button
                android:id="@+id/btnNext"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:text="Next >"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:elevation="10dp"
                android:background="@drawable/green_pill"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                app:layout_constraintTop_toTopOf="@id/btnBack"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
