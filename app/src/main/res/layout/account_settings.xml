<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/logoCircle"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/logo_circle_black"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher_logo" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/glassCardAccount"
        android:layout_width="0dp"
        android:layout_height="520dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_glass_dashboard"
        app:layout_constraintTop_toBottomOf="@id/logoCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/accountInner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="22dp">

            <TextView
                android:id="@+id/accountHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Settings"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_extrabold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Change Email -->
            <EditText
                android:id="@+id/etChangeEmail"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginTop="42dp"
                android:background="@drawable/acct_block"
                android:hint="Change Email"
                android:textColor="#FFFFFF"
                android:textColorHint="#9C9C9C"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                app:layout_constraintTop_toBottomOf="@id/accountHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Confirm Email -->
            <EditText
                android:id="@+id/etConfirmEmail"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/acct_block"
                android:hint="Confirm Email"
                android:textColor="#FFFFFF"
                android:textColorHint="#9C9C9C"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                app:layout_constraintTop_toBottomOf="@id/etChangeEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Change Password -->

            <!-- Confirm Password -->

            <EditText
                android:id="@+id/etChangePassword"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/acct_block"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:hint="Change Password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#9C9C9C"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etCurrentPassword" />

            <EditText
                android:id="@+id/etCurrentPassword"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/acct_block"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:hint="Current Password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#9C9C9C"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etConfirmEmail" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/acct_block"
                android:hint="Confirm Password"
                android:textColor="#FFFFFF"
                android:textColorHint="#9C9C9C"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:inputType="textPassword"
                android:singleLine="true"
                app:layout_constraintTop_toBottomOf="@id/etChangePassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Save button -->
            <FrameLayout
                android:id="@+id/saveAccountButtonWrap"
                android:layout_width="84dp"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/etConfirmPassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/SaveAccountButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/save_button"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>


    <FrameLayout
        android:id="@+id/backButtonWrap"
        android:layout_width="94dp"
        android:layout_height="56dp"
        android:layout_marginTop="34dp"
        app:layout_constraintTop_toBottomOf="@id/glassCardAccount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/BackButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/btn_back"
            android:scaleType="fitCenter"
            android:onClick="onSettingsClick"
            android:contentDescription="@null" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>