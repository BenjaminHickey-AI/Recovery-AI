<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Glass card -->
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="22dp"
        android:background="@drawable/bg_glass"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="22dp">

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="What's your weight?"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="@font/inter_bold"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Don’t worry. you can always change it later."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:fontFamily="@font/manrope_regular"
                app:layout_constraintTop_toBottomOf="@id/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Number box -->
            <TextView
                android:id="@+id/weight"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/metric_box"
                android:text="174"
                android:textColor="@android:color/white"
                android:textSize="40sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="@font/inter_bold"
                android:elevation="12dp"
                app:layout_constraintTop_toBottomOf="@id/subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/btnBack"
                android:layout_marginBottom="22dp" />

            <!-- Back -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="18sp"
                android:background="@drawable/green_pill"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"
                android:elevation="10dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnNext"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontalChainStyle="packed" />

            <!-- Next -->
            <Button
                android:id="@+id/btnNext"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:text="Next >"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="18sp"
                android:elevation="10dp"
                android:background="@drawable/green_pill"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"
                android:layout_marginBottom="8dp"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
