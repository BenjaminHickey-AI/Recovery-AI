<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/logoCircle"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/logo_circle_black"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher_logo" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/glassCardAccount"
        android:layout_width="0dp"
        android:layout_height="520dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_glass_dashboard"
        app:layout_constraintTop_toBottomOf="@id/logoCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/accountInner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="22dp">

            <TextView
                android:id="@+id/accountHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Are you sure you want to delete your account?"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_extrabold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Change Email -->

            <!-- Confirm Email -->

            <!-- Change Password -->

            <!-- Confirm Password -->

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:background="@drawable/acct_block"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#9C9C9C"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="90dp"
                android:layout_height="54dp"
                android:background="@drawable/save_pill_workout"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text=""
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.15"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/btnBackLabel"
                android:layout_width="90dp"
                android:layout_height="46dp"
                android:text="BACK"
                android:textColor="#0A0A0A"
                android:textStyle="bold"
                android:textSize="14sp"
                android:fontFamily="@font/inter_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="false"
                android:focusable="false"
                app:layout_constraintTop_toTopOf="@id/btnBack"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toStartOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="@id/btnBack" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="90dp"
                android:layout_height="54dp"
                android:background="@drawable/save_pill_workout"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text=""
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.884"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/btnDeleteLabel"
                android:layout_width="90dp"
                android:layout_height="46dp"
                android:text="DELETE"
                android:textColor="#0A0A0A"
                android:textStyle="bold"
                android:textSize="14sp"
                android:fontFamily="@font/inter_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="false"
                android:focusable="false"
                app:layout_constraintTop_toTopOf="@id/btnDelete"
                app:layout_constraintBottom_toBottomOf="@id/btnDelete"
                app:layout_constraintStart_toStartOf="@id/btnDelete"
                app:layout_constraintEnd_toEndOf="@id/btnDelete" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>