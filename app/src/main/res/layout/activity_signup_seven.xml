<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Glass card container -->
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="22dp"
        android:background="@drawable/bg_glass"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="22dp">

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="What’s your goal?"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="You can choose more than one goal - you can\nalways change it later."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:fontFamily="@font/manrope_regular"
                app:layout_constraintTop_toBottomOf="@id/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Goals stack -->
            <LinearLayout
                android:id="@+id/goalsStack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <Button
                    android:id="@+id/btnGetFit"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Get Fit"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter_extrabold"
                    android:background="@drawable/black_pill"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"/>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="12dp"/>

                <Button
                    android:id="@+id/btnLoseWeight"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Lose Weight"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter_extrabold"
                    android:background="@drawable/black_pill"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"/>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="12dp"/>

                <Button
                    android:id="@+id/btnBuildMuscle"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Build Muscle"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter_extrabold"
                    android:background="@drawable/black_pill"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"/>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="12dp"/>

                <Button
                    android:id="@+id/btnInjuryPrevention"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Injury prevention"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter_extrabold"
                    android:background="@drawable/black_pill"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"/>

            </LinearLayout>

            <!-- Back / Finish -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="18sp"
                android:background="@drawable/green_pill"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"
                android:elevation="10dp"
                app:layout_constraintTop_toBottomOf="@id/goalsStack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnFinish"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="14dp"/>

            <Button
                android:id="@+id/btnFinish"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:text="Finish >>"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="18sp"
                android:fontFamily="@font/inter_extrabolditalic"
                android:background="@drawable/green_pill"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"
                android:elevation="10dp"
                app:layout_constraintTop_toTopOf="@id/btnBack"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
